---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import Icon from '../../components/Icon.astro';

// Hanya proyek dengan caseStudy: true yang punya halaman.
export async function getStaticPaths() {
  const entries = await getCollection('projects', (p) => p.data.caseStudy);
  return entries.map((entry) => {
    if (!entry.body?.trim()) {
      throw new Error(`Project "${entry.id}" has caseStudy: true but an empty body.`);
    }
    return { params: { slug: entry.id }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
if (!entry.data.cover || !entry.data.coverAlt) throw new Error(`Case study "${entry.id}" needs cover and coverAlt.`);
const { title, subtitle, code, year, role, stack, summary, version, links, cover, coverAlt, gallery } = entry.data;
const slug = entry.id;
const parts = subtitle.split(/([㐀-鿿]+)/).filter(Boolean);
const meta = [
  { label: 'Role', value: role },
  { label: 'Stack', value: stack.join(', ') },
  ...(version ? [{ label: 'Version', value: `v${version}` }] : []),
];
---

<Base
  title={`${title} case study | Rindang Tulus`}
  description={summary}
  image={`/og/${slug}.png`}
  imageAlt={`${code} · Case study. ${title}. ${summary} rindangtulus.github.io`}
  type="article"
>
  <article id="top">
    <header class="pb-12 pt-32 md:pb-16 md:pt-40">
      <div class="container-page">
        <p class="label">{code}{year ? ` · ${year}` : ''}</p>
        <h1 class="title-case mt-4" transition:name={`title-${slug}`}>{title}</h1>
        <p class="mt-3 text-lg text-muted md:text-xl">
          {parts.map((p) => (/[㐀-鿿]/.test(p) ? <span lang="zh-Hant">{p}</span> : p))}
        </p>
        <p class="mt-8 max-w-[36ch] text-2xl font-medium leading-snug tracking-[-0.02em] text-ink md:text-3xl">{summary}</p>

        <dl class="mt-12 grid gap-x-8 border-t border-line sm:grid-cols-2 lg:grid-cols-4">
          {
            meta.map((m) => (
              <div class="border-b border-line py-4 lg:border-b-0">
                <dt class="label">{m.label}</dt>
                <dd class="mt-1 text-base text-ink">{m.value}</dd>
              </div>
            ))
          }
          {
            links.demo && (
              <div class="border-b border-line py-4 lg:border-b-0">
                <dt class="label">Demo</dt>
                <dd class="mt-1">
                  <a
                    href={links.demo}
                    target="_blank"
                    rel="noopener"
                    class="link inline-flex min-h-11 items-center gap-1.5 text-base font-medium"
                  >
                    Live demo <Icon name="arrow-up-right" class="size-4" />
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                </dd>
              </div>
            )
          }
        </dl>

        <div class="mt-12 aspect-[16/10] overflow-hidden rounded-lg border border-line bg-surface md:mt-16">
          <Image
            src={cover}
            alt={coverAlt}
            widths={[720, 1080, 1440]}
            sizes="(min-width: 1240px) 1160px, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="size-full object-cover object-top"
          />
        </div>
      </div>
    </header>

    <section class="pb-20 md:pb-28" aria-label="Case study">
      <div class="container-page">
        <div class="case-prose" data-reveal>
          <Content />
        </div>
      </div>
    </section>

    <section class="pb-20 md:pb-28" aria-labelledby="gallery-title">
      <div class="container-page" data-reveal>
        <h2 id="gallery-title" class="title-section">Screens</h2>
        <div class="mt-10 md:mt-14">
          <Gallery items={gallery} />
        </div>
      </div>
    </section>

    <div class="border-t border-line">
      <div class="container-page py-8">
        <a href="/#work" class="link inline-flex min-h-11 items-center gap-2 text-base font-medium">
          <Icon name="arrow-left" class="size-4" /> Back to work
        </a>
      </div>
    </div>
  </article>
</Base>
