---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectRow from '../components/ProjectRow.astro';
import ListRows from '../components/ListRows.astro';
import Icon from '../components/Icon.astro';
import portrait from '../assets/profile/rindang-web.jpg'; // salinan terkompres tanpa EXIF/XMP/GPS
import { getCollection } from 'astro:content';
import { experience } from '../data/experience';
import { credentials } from '../data/credentials';
import { skills } from '../data/skills';
import { getNow } from '../data/now';
import { site } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const now = await getNow();
// Data terstruktur Person: hanya fakta di CLAUDE.md; tanpa email dan tanpa worksFor.
const personLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'IT Project Manager',
  url: site.url,
  sameAs: [site.linkedin, site.github],
});
const period = (e: { start: number; end: number | null }) =>
  e.end === null ? `${e.start} – Present` : e.end === e.start ? `${e.start}` : `${e.start} – ${e.end}`;
const experienceItems = experience.map((e) => ({ when: period(e), title: e.role, sub: e.org, points: e.points }));
const credentialItems = credentials.map((c) => ({ when: String(c.year), title: c.title, sub: c.issuer }));
---

<Base>
  <script type="application/ld+json" slot="head" set:html={personLd} />
  <Hero />

  <section id="work" class="py-20 md:py-28" aria-labelledby="work-title">
    <div class="container-page">
      <div data-reveal>
        <h2 id="work-title" class="title-section">Selected work</h2>
        <p class="mt-4 max-w-[48ch] text-lg text-muted">Projects I have led, designed or built. Open the first one for the full case study.</p>
      </div>
      <div class="mt-12 border-t border-line md:mt-16" data-reveal>
        {projects.map((p) => <ProjectRow project={p} />)}
      </div>
    </div>
  </section>

  <section id="about" class="py-20 md:py-28" aria-labelledby="about-title">
    <div class="container-page grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4" data-reveal>
        <h2 id="about-title" class="title-section">About</h2>
        <Image
          src={portrait}
          alt="Portrait of Rindang Tulus Sumalyo"
          widths={[360, 480, 720]}
          sizes="(min-width: 768px) 30vw, 70vw"
          class="mt-8 aspect-[4/5] w-[70%] max-w-xs rounded-lg object-cover md:w-full md:max-w-none"
        />
      </div>
      <div class="md:col-span-7 md:col-start-6" data-reveal>
        <p class="text-2xl font-medium leading-snug tracking-[-0.02em] text-ink md:text-3xl">{site.about[0]}</p>
        <div class="mt-8 space-y-5 text-lg text-muted">
          {site.about.slice(1).map((t) => <p>{t}</p>)}
        </div>
        <h3 class="label mt-14">Skills</h3>
        <dl class="mt-4 border-t border-line">
          {
            skills.map((g) => (
              <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[9rem_1fr] sm:gap-6">
                <dt class="label sm:pt-1">{g.group}</dt>
                <dd class="text-base text-ink">{g.items.join(', ')}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section id="experience" class="py-20 md:py-28" aria-labelledby="experience-title">
    <div class="container-page">
      <h2 id="experience-title" class="title-section" data-reveal>Experience</h2>
      <div class="mt-12 md:mt-16" data-reveal>
        <ListRows items={experienceItems} />
      </div>
      <h3 class="label mt-16 md:mt-20" data-reveal>Credentials</h3>
      <div class="mt-4" data-reveal>
        <ListRows items={credentialItems} />
      </div>
    </div>
  </section>

  <section class="pb-8 pt-12 md:pt-16" aria-labelledby="now-title">
    <div class="container-page grid gap-6 md:grid-cols-12 md:gap-8" data-reveal>
      <h2 id="now-title" class="label md:col-span-4 md:pt-1.5">Now</h2>
      <ul class="space-y-2 text-lg text-ink md:col-span-7 md:col-start-6">
        {now.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <section id="contact" class="py-20 md:py-28" aria-labelledby="contact-title">
    <div class="container-page">
      <div data-reveal>
        <h2 id="contact-title" class="title-section">Contact</h2>
        <p class="mt-4 max-w-[48ch] text-lg text-muted">{site.contactLine}</p>
        <p class="mt-10">
          <a
            href={`mailto:${site.email}`}
            class="link email-link inline-block text-[clamp(1.625rem,5.2vw,4rem)] font-medium leading-tight tracking-[-0.035em]"
          >
            {site.email}
          </a>
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <button type="button" class="btn-outline" data-copy={site.email}>
            <Icon name="copy" class="size-4" /><span data-copy-label>Copy address</span>
          </button>
          <a class="link inline-flex min-h-11 items-center gap-1.5 text-base font-medium" href={site.linkedin} rel="me noopener" target="_blank">
            LinkedIn <Icon name="arrow-up-right" class="size-4" /><span class="sr-only">(opens in a new tab)</span>
          </a>
          <a class="link inline-flex min-h-11 items-center gap-1.5 text-base font-medium" href={site.github} rel="me noopener" target="_blank">
            GitHub <Icon name="arrow-up-right" class="size-4" /><span class="sr-only">(opens in a new tab)</span>
          </a>
          <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
        </div>
      </div>
    </div>
  </section>
</Base>

