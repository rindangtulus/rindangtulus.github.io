---
// Daftar bersih: periode | judul + keterangan. Dipakai Experience dan Credentials.
interface Item {
  when: string;
  title: string;
  sub: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ul class="border-t border-line">
  {
    items.map((it) => (
      <li class="grid gap-1.5 border-b border-line py-6 md:grid-cols-[12rem_1fr] md:gap-8 md:py-7">
        <p class="label md:pt-1.5">{it.when}</p>
        <div>
          <p class="text-xl font-medium leading-snug tracking-[-0.015em] text-ink md:text-2xl">{it.title}</p>
          <p class="mt-0.5 text-base text-muted">{it.sub}</p>
        </div>
      </li>
    ))
  }
</ul>
