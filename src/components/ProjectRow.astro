---
import type { Project } from '../data/projects';
import Icon from './Icon.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
// Aksara Han diberi lang="zh-Hant" agar memakai glif tradisional yang benar.
const parts = project.subtitle.split(/([㐀-鿿]+)/).filter(Boolean);
const stack = project.stack.slice(0, 3).join(' · ');
---

<a
  href={`/projects/${project.slug}`}
  class="group grid grid-cols-[1fr_auto] items-center gap-x-6 gap-y-3 border-b border-line py-7 transition-colors duration-300 hover:border-accent focus-visible:border-accent md:grid-cols-[3.5rem_1fr_minmax(0,22rem)_auto] md:gap-x-8 md:py-9"
>
  <span class="label hidden md:block">{project.code}</span>
  <span class="min-w-0">
    <span class="block text-2xl font-medium leading-tight tracking-[-0.02em] text-ink">{project.title}</span>
    <span class="mt-1 block text-base text-muted">
      {parts.map((p) => (/[㐀-鿿]/.test(p) ? <span lang="zh-Hant">{p}</span> : p))}
    </span>
  </span>
  <span class="label order-last col-span-1 col-start-1 row-start-2 md:order-none md:col-start-auto md:row-start-auto"><span class="block">{project.role}</span><span class="block">{stack}</span></span>
  <span class="col-start-2 row-span-2 row-start-1 flex size-11 items-center justify-center text-ink md:col-start-auto md:row-span-1 md:row-start-auto">
    <Icon
      name="arrow-right"
      class="size-6 transition-[transform,color] duration-300 group-hover:translate-x-1 group-hover:text-accent group-focus-visible:translate-x-1 group-focus-visible:text-accent"
    />
  </span>
</a>
