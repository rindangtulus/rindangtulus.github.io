---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<footer class="border-t border-line">
  <div class="container-page flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between">
    <p class="text-sm text-muted">&copy; 2026 {site.name}. Based in Surabaya.</p>
    <a class="link inline-flex min-h-11 items-center gap-1.5 text-base" href="#top">
      Back to top <Icon name="arrow-up" />
    </a>
  </div>
</footer>
