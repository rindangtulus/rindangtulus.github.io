---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  image: ImageMetadata;
  alt: string;
  caption: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
// Gambar tinggi (layar HP) dipisah dari gambar laptop supaya tampil seperti layar HP.
const isPhone = (i: Item) => i.image.height / i.image.width > 1.5;
const laptops = items.filter((i) => !isPhone(i));
const phones = items.filter(isPhone);
---

<div>
  <ul class="grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-10">
    {
      laptops.map((it) => (
        <li>
          <figure>
            <div class="aspect-[16/10] overflow-hidden rounded-lg border border-line bg-surface">
              <Image
                src={it.image}
                alt={it.alt}
                widths={[400, 800]}
                sizes="(min-width: 1240px) 380px, (min-width: 1024px) 30vw, 46vw"
                loading="lazy"
                decoding="async"
                class="size-full object-cover object-top"
              />
            </div>
            <figcaption class="mt-3 text-sm leading-snug text-muted">{it.caption}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>

  {
    phones.length > 0 && (
      <ul class="mt-10 flex gap-4 lg:mt-12 lg:gap-6">
        {phones.map((it) => (
          <li class="w-[calc(50%-0.5rem)] max-w-[280px]">
            <figure>
              <div class="aspect-[9/13] overflow-hidden rounded-2xl border border-line bg-surface">
                <Image
                  src={it.image}
                  alt={it.alt}
                  widths={[280, 560]}
                  sizes="(min-width: 640px) 280px, 46vw"
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover object-top"
                />
              </div>
              <figcaption class="mt-3 text-sm leading-snug text-muted">{it.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    )
  }
</div>
